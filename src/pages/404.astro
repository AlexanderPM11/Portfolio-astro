---
import Layout from "../layouts/Layout.astro";
import Button from "../components/common/Button.astro";
import { Home, BookOpen, ArrowLeft } from "lucide-astro";

Astro.response.status = 404;
---

<Layout>
  <div
    class="relative bg-[#0b1926] min-h-[calc(100vh-0px)] pt-32 pb-20 overflow-hidden font-sans flex items-center"
  >
    <div
      class="absolute top-1/4 right-0 w-[480px] h-[480px] bg-orange-500/10 rounded-full blur-[100px] translate-x-1/2 pointer-events-none"
    >
    </div>
    <div
      class="absolute bottom-1/4 left-0 w-[520px] h-[520px] bg-blue-600/10 rounded-full blur-[120px] -translate-x-1/3 pointer-events-none"
    >
    </div>

    <div class="relative z-10 w-full max-w-3xl mx-auto px-6 lg:px-10 text-center">
      <p
        class="text-[clamp(6rem,22vw,11rem)] font-extrabold leading-none tracking-tighter text-transparent bg-clip-text bg-gradient-to-b from-white via-gray-300 to-gray-600/40 select-none"
        aria-hidden="true"
      >
        404
      </p>

      <div
        class="mt-2 md:-mt-4 bg-[#112233]/80 backdrop-blur-2xl border border-white/10 rounded-[2rem] p-8 md:p-12 shadow-2xl relative"
      >
        <div
          class="absolute inset-0 bg-gradient-to-b from-white/[0.05] to-transparent rounded-[2rem] pointer-events-none"
        >
        </div>

        <div class="relative z-10">
          <div
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-sm font-medium mb-6"
          >
            Página no encontrada
          </div>

          <h1 class="text-2xl md:text-4xl font-bold text-white mb-4 tracking-tight">
            Esta ruta no existe en el mapa
          </h1>
          <p class="text-gray-400 text-lg leading-relaxed max-w-xl mx-auto mb-10">
            Es posible que el enlace esté roto, que la página se haya movido o que
            hayas escrito mal la URL. Puedes volver al inicio o explorar el blog.
          </p>

          <div
            class="flex flex-col sm:flex-row items-center justify-center gap-4"
          >
            <Button
              href="/"
              variant="primary"
              icon={Home}
              iconPosition="left"
              class="bg-orange-600 hover:bg-orange-500 border-0 min-w-[200px]"
            >
              Ir al inicio
            </Button>
            <Button
              href="/blog"
              variant="secondary"
              icon={BookOpen}
              iconPosition="left"
              class="min-w-[200px]"
            >
              Ver el blog
            </Button>
          </div>

          <button
            type="button"
            onclick="history.back()"
            class="mt-8 inline-flex items-center gap-2 text-gray-400 hover:text-orange-400 text-sm font-medium transition-colors duration-300"
          >
            <ArrowLeft class="w-4 h-4" stroke="currentColor" />
            Volver a la página anterior
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>
