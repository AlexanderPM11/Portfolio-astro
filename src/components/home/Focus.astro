---
import { FileScan, Workflow, DatabaseZap } from "lucide-astro";
import SectionHeading from "../common/SectionHeading.astro";

const focusAreas = [
  { icon: FileScan, number: "01", title: "Digitalización documental", text: "Procesamiento de documentos, extracción de texto, validación de información y organización de expedientes digitales." },
  { icon: Workflow, number: "02", title: "Automatización de procesos", text: "Flujos para recibir, transformar, validar, almacenar y distribuir información con menos trabajo manual." },
  { icon: DatabaseZap, number: "03", title: "Sistemas conectados", text: "APIs, bases de datos e integraciones que convierten datos dispersos en procesos claros y trazables." },
];
---

<section id="focus" class="relative overflow-hidden bg-[#0d111b] px-6 py-24 text-white lg:px-10">
  <div class="mx-auto max-w-7xl">
    <SectionHeading label="Dónde puedo aportar" title="Tecnología con" highlight="propósito" description="Una combinación de software, automatización y criterio para convertir operaciones manuales en información organizada y útil." />
    <div class="grid gap-5 md:grid-cols-3">
      {focusAreas.map(({ icon: Icon, number, title, text }) => (
        <article class="group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.035] p-7 transition duration-500 hover:-translate-y-2 hover:border-orange-400/40 hover:bg-orange-400/[0.06]">
          <div class="mb-16 flex items-start justify-between"><div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-orange-400/10 text-orange-300"><Icon class="h-6 w-6" /></div><span class="font-mono text-xs text-slate-600">{number}</span></div>
          <h3 class="text-2xl font-bold tracking-tight">{title}</h3><p class="mt-4 leading-7 text-slate-400">{text}</p>
          <div class="mt-7 h-px w-12 bg-orange-400 transition-all duration-500 group-hover:w-24"></div>
        </article>
      ))}
    </div>
  </div>
</section>
